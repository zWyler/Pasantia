# ==========================================

# FRONTEND — REACT / VITE

# ==========================================

frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/logs/
frontend/*.log
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*
frontend/lerna-debug.log*

# Editores y herramientas

frontend/.vscode/*
!frontend/.vscode/extensions.json
frontend/.idea/
frontend/*.suo
frontend/*.ntvs*
frontend/*.njsproj
frontend/*.sln
frontend/*.sw?

# ==========================================

# BACKEND — LARAVEL / PHP

# ==========================================

# Credenciales y configuración local

backend/.env
backend/.env.*
!backend/.env.example
backend/auth.json

# Dependencias y archivos generados

backend/vendor/
backend/node_modules/
backend/public/build/
backend/public/hot
backend/public/storage
backend/storage/*.key
backend/storage/pail
backend/bootstrap/cache/*.php
backend/.phpunit.result.cache
backend/.phpunit.cache

# Editores

backend/.fleet/
backend/.idea/
backend/.nova/
backend/.vscode/
backend/.zed/
backend/.phpactor.json

# Archivos del sistema

backend/*.log
backend/.DS_Store
backend/Thumbs.db
backend/Homestead.json
backend/Homestead.yaml

# ==========================================

# ARCHIVOS GENERALES

# ==========================================

*.log
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ==========================================

# CACHÉS Y ARCHIVOS TEMPORALES

# ==========================================

backend/storage/framework/cache/data/*
!backend/storage/framework/cache/data/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/logs/*
!backend/storage/logs/.gitignore

# Copias de seguridad locales de controladores
backend/app/Http/Controllers/*.backup.php
# Archivo RAR accidental en componentes del frontend
/frontend/src/components/New Archivo WinRAR.rar

./Sprints